# ─────────────────────────────────────────────────────────
#  MarathonLMS — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — leave blank to use SQLite in dev
# For PostgreSQL set: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── Storage (S3 / DigitalOcean Spaces) ──────────────────
# Uncomment and fill in to switch from local to cloud storage
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# ── Email Configuration ────────────────────────────────
# Choose one method: Brevo API OR SMTP
#
# Option 1: Brevo (HTTP API — recommended for Railway)
# BREVO_API_KEY=your_brevo_api_key_here
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com   ← REQUIRED with Brevo; must be verified in Brevo dashboard
#
# Option 2: Gmail/SMTP (standard SMTP setup)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password-here
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=your-email@gmail.com
#
# For Gmail:
#   1. Enable 2-Step Verification in your Google Account
#   2. Generate an App Password at https://myaccount.google.com/apppasswords
#   3. Use that password in EMAIL_HOST_PASSWORD
#
# If neither is configured, emails will print to console in development.

# ── Cloudinary (alternative) ─────────────────────────────
# USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
