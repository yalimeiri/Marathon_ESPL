# ─────────────────────────────────────────────────────────
#  MarathonLMS — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — leave blank to use SQLite in dev
# For PostgreSQL set: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── Storage (S3 / DigitalOcean Spaces) ──────────────────
# Uncomment and fill in to switch from local to cloud storage
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=

# ── Cloudinary (alternative) ─────────────────────────────
# USE_CLOUDINARY=False
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
